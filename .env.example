FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6387
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_GRAPH=recurtrace
# Optional OpenAI-compatible provider; leave key empty for reproducible demo mode.
AI_BASE_URL=https://ai.gateway.vercel.sh/v1
AI_MODEL=openai/gpt-4.1-mini
AI_API_KEY=
# Keep false for the public free demo. AI calls require deliberate opt-in.
ENABLE_AI=false
PUBLIC_DEMO=false
SESSION_SECRET=replace-with-a-long-random-string-before-hosting
